# cp env.list.example env.list and paste the tenant API token printed by the
# hatchet-lite setup step (see the README). Never commit the filled-in file.
HATCHET_CLIENT_TOKEN=
HATCHET_CLIENT_HOST_PORT=hatchet-lite:7077
HATCHET_CLIENT_SERVER_URL=http://hatchet-lite:8888
HATCHET_CLIENT_TLS_STRATEGY=none
PYTHONUNBUFFERED=1
